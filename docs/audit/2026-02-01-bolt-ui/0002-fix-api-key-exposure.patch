+import { json, type LoaderFunctionArgs } from '@remix-run/cloudflare';
+
+/**
+ * Public configuration endpoint
+ *
+ * Returns non-sensitive configuration that can be safely exposed to clients.
+ * NEVER include API keys, secrets, or tokens here.
+ *
+ * @example
+ * const config = await fetch('/api/config/public').then(r => r.json());
+ * console.log(config.ollama.baseUrl);
+ */
+export const loader = async ({ request: _request }: LoaderFunctionArgs) => {
+  return json({
+    ollama: {
+      baseUrl: process.env.OLLAMA_API_BASE_URL || 'http://localhost:11434',
+    },
+    lmstudio: {
+      baseUrl: process.env.LMSTUDIO_API_BASE_URL || 'http://localhost:1234',
+    },
+    // Add other PUBLIC configuration here (URLs, feature flags, etc.)
+  });
+};
diff --git a/apps/bolt-ui/tests/security/api-key-exposure.spec.ts b/apps/bolt-ui/tests/security/api-key-exposure.spec.ts
