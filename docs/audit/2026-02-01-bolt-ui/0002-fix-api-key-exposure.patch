@@ -0,0 +1,45 @@
+import { describe, it, expect } from 'vitest';
+import * as fs from 'fs';
+import * as path from 'path';
+
+describe('API Key Exposure Prevention', () => {
+  it('should not include API keys in client bundle', async () => {
+    const buildDir = path.join(__dirname, '../../build/client');
+
+    // Skip if build doesn't exist (development mode)
+    if (!fs.existsSync(buildDir)) {
+      console.warn('⚠️  Build directory not found, run `pnpm build` first');
+      return;
+    }
+
+    // Recursively find all .js files in build/client
+    const jsFiles: string[] = [];
+    function walk(dir: string) {
+      const files = fs.readdirSync(dir);
+      for (const file of files) {
+        const filePath = path.join(dir, file);
+        const stat = fs.statSync(filePath);
+        if (stat.isDirectory()) {
+          walk(filePath);
+        } else if (file.endsWith('.js')) {
+          jsFiles.push(filePath);
+        }
+      }
+    }
+    walk(buildDir);
+
+    // Dangerous patterns that should NEVER appear in client bundle
+    const dangerousPatterns = [
+      /OPENAI_API_KEY/i,
+      /ANTHROPIC_API_KEY/i,
+      /GITHUB_API_KEY/i,
+      /sk-[a-zA-Z0-9]{48}/, // OpenAI key pattern
+      /sk-ant-[a-zA-Z0-9-]{95}/, // Anthropic key pattern
+    ];
+
+    for (const file of jsFiles) {
+      const content = fs.readFileSync(file, 'utf-8');
+      for (const pattern of dangerousPatterns) {
+        expect(content, `Found ${pattern} in ${path.basename(file)}`).not.toMatch(pattern);
+      }
+    }
+
+    console.log(`✓ Scanned ${jsFiles.length} JS files, no API keys found`);
+  });
+});
