diff --git a/apps/bolt-ui/tests/api-e2b-security.spec.ts b/apps/bolt-ui/tests/api-e2b-security.spec.ts
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/apps/bolt-ui/tests/api-e2b-security.spec.ts
@@ -0,0 +1,85 @@
+import { describe, it, expect, beforeAll, afterAll } from 'vitest';
+
+const API_BASE = 'http://localhost:5192/api/e2b';
+
+describe('E2B API - Command Injection Prevention', () => {
+  let sandboxId: string;
+
+  beforeAll(async () => {
+    // Create sandbox for testing
+    const res = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ action: 'create' }),
+    });
+
+    if (!res.ok) {
+      throw new Error(`Failed to create sandbox: ${await res.text()}`);
+    }
+
+    const data = await res.json();
+    sandboxId = data.sandboxId;
+    console.log('Test sandbox created:', sandboxId);
+  });
+
+  afterAll(async () => {
+    // Cleanup sandbox
+    if (sandboxId) {
+      await fetch(API_BASE, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'destroy', sandboxId }),
+      });
+      console.log('Test sandbox destroyed:', sandboxId);
+    }
+  });
+
+  it('should prevent command injection via path parameter with double quotes', async () => {
+    const maliciousPath = 'test"; rm -rf /tmp/test-marker-1; echo "';
+
+    const res = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'files.write',
+        sandboxId,
+        path: maliciousPath,
+        content: 'test content',
+      }),
+    });
+
+    expect(res.ok).toBe(true);
+
+    // Verify the malicious command was NOT executed
+    const checkRes = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'commands.run',
+        sandboxId,
+        command: 'test -f /tmp/test-marker-1 && echo "VULNERABLE" || echo "SAFE"',
+      }),
+    });
+
+    const checkData = await checkRes.json();
+    expect(checkData.stdout.trim()).toBe('SAFE');
+  });
+
+  it('should correctly escape single quotes in paths', async () => {
+    const pathWithQuotes = "test'file'name.txt";
+
+    const res = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'files.write',
+        sandboxId,
+        path: pathWithQuotes,
+        content: 'content with quotes',
+      }),
+    });
+
+    expect(res.ok).toBe(true);
+    const data = await res.json();
+    expect(data.success).toBe(true);
+  });
+
+  it('should prevent backtick injection', async () => {
+    const maliciousPath = 'test`whoami`.txt';
+
+    const res = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'files.write',
+        sandboxId,
+        path: maliciousPath,
+        content: 'test',
+      }),
+    });
+
+    expect(res.ok).toBe(true);
+
+    // File should be created with literal backticks, not command execution
+    const readRes = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'files.read',
+        sandboxId,
+        path: maliciousPath,
+      }),
+    });
+
+    expect(readRes.ok).toBe(true);
+    const readData = await readRes.json();
+    expect(readData.content).toBe('test');
+  });
+
+  it('should handle path traversal attempts safely', async () => {
+    const traversalPath = '../../../etc/passwd';
+
+    const res = await fetch(API_BASE, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'files.write',
+        sandboxId,
+        path: traversalPath,
+        content: 'hacked',
+      }),
+    });
+
+    // Should be blocked or normalized to project directory
+    expect(res.ok).toBe(true);
+    const data = await res.json();
+
+    // Path should be normalized to BASE_PATH
+    expect(data.path).toContain('/home/user/project');
+    expect(data.path).not.toContain('/etc/passwd');
+  });
+});
