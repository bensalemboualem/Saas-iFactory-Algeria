# Dockerfile.staging

FROM node:20-alpine AS base
RUN npm install -g pnpm

# Install dependencies only when needed
FROM base AS deps
WORKDIR /app

# Copy package.json files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/tools-registry/package.json ./packages/tools-registry/
COPY packages/database/package.json ./packages/database/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY . .

# Build dependencies/packages
RUN cd packages/tools-registry && pnpm build
RUN cd packages/database && pnpm build

# Build web app
ENV NODE_ENV=production
RUN cd apps/web && pnpm build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/apps/web/public ./public

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000

# server.js is created by next build in the standalone directory
# But standalone output puts the server.js in apps/web/server.js?
# Usually it preserves the structure.
# Let's verify commonly usage.
# If standalone is enabled in next.config.mjs, it outputs to .next/standalone.
# Inside standalone, it keeps project structure e.g. apps/web/server.js.
# So CMD should be ["node", "apps/web/server.js"].

CMD ["node", "apps/web/server.js"]
