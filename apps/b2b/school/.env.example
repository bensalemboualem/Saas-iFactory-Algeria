# OnestSchooled - Environment Variables Template
# INSTRUCTIONS: Copiez ce fichier vers .env et remplissez les valeurs
# cp .env.example .env

# ============================================
# APPLICATION
# ============================================
APP_NAME="OnestSchooled"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=base64:GENERATE_NEW_KEY_WITH_artisan_key_generate
APP_DEBUG=false
APP_DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
APP_MAIN_APP_URL=yourdomain.com
APP_API_URL="${APP_URL}/api/public/v1"
APP_HTTPS=true
LOG_CHANNEL=daily
APP_TRANSLATE=false
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
APP_DIR=rtl
APP_CACHE_TIME=100
LARAVEL_PAGE_SPEED_ENABLE=true
APP_SAAS=false
APP_PDO=false
APP_DEMO=false

QUEUE_CONNECTION="database"

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE="your_database_name"
DB_USERNAME=your_db_username
DB_PASSWORD="YOUR_SECURE_DB_PASSWORD"

# ============================================
# CACHE
# ============================================
CACHE_DRIVER=redis

# ============================================
# REDIS
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# ============================================
# BROADCASTING & SESSION
# ============================================
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# ============================================
# MAIL
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="YOUR_APP_PASSWORD"
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_ENCRYPTION="tls"
MAIL_FROM_NAME="OnestSchooled"

# ============================================
# AWS S3
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# PUSHER
# ============================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAP_KEY=""

# ============================================
# FIREBASE
# ============================================
FIREBASE_CREDENTIALS="firebase_credentials.json"
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""
FIREBASE_COLLECTION=""

# ============================================
# STRIPE - https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_KEY="pk_test_YOUR_PUBLISHABLE_KEY"
STRIPE_SECRET="sk_test_YOUR_SECRET_KEY"
