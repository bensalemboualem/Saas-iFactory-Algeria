# OnestSchooled - NEW SECURE ENVIRONMENT FILE
# Date: 30 Decembre 2025
# IMPORTANT: Remplissez les valeurs et renommez en .env
# mv .env.new .env

# ============================================
# APPLICATION
# ============================================
APP_NAME="OnestSchooled"
APP_ENV=production
# Regenerer avec: php artisan key:generate
APP_KEY=base64:__REGENERER_AVEC_ARTISAN__
APP_DEBUG=false
APP_DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
APP_MAIN_APP_URL=yourdomain.com
APP_API_URL="${APP_URL}/api/public/v1"
APP_HTTPS=true
LOG_CHANNEL=daily
LOG_LEVEL=error
APP_DIR=rtl
APP_CACHE_TIME=100
LARAVEL_PAGE_SPEED_ENABLE=true
APP_SAAS=false
APP_TRANSLATE=true
APP_PDO=false
APP_DEMO=false
APP_VER="2.0"

QUEUE_CONNECTION=database

# ============================================
# DATABASE - CHANGER LE MOT DE PASSE!
# ============================================
DATABASE_URL=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=onest_school
DB_USERNAME=onestschooled_user
DB_PASSWORD=__NOUVEAU_MOT_DE_PASSE_DB__

# ============================================
# CACHE & REDIS
# ============================================
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# ============================================
# SESSION
# ============================================
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
SESSION_DRIVER=file
SESSION_LIFETIME=120
MEMCACHED_HOST=127.0.0.1

# ============================================
# MAIL - CHANGER LES CREDENTIALS!
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=__VOTRE_EMAIL__
MAIL_PASSWORD=__NOUVEAU_APP_PASSWORD__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="OnestSchooled"

# ============================================
# JWT - REGENERER!
# ============================================
# Commande: php artisan jwt:secret
JWT_SECRET=__REGENERER_AVEC_ARTISAN__

# ============================================
# AWS S3 (optionnel)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# PUSHER (optionnel)
# ============================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================
# CAPTCHA (optionnel)
# ============================================
NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# ============================================
# GOOGLE MAPS (optionnel)
# ============================================
GOOGLE_MAP_KEY=

# ============================================
# FIREBASE (optionnel)
# ============================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_COLLECTION=

# ============================================
# STRIPE - REGENERER APRES REVOCATION!
# https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_KEY=pk_test___NOUVELLE_CLE__
STRIPE_SECRET=sk_test___NOUVELLE_CLE__
