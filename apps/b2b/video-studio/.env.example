# ============================================
# IAFACTORY VIDEO STUDIO PRO - TEMPLATE
# Copy this file to .env.ready and fill in your keys
# ============================================

# === LLMs & AI APIs ===
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXX
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXX
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXX
MISTRAL_API_KEY=XXXXXXXXXXXXXXXX
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXX
COHERE_API_KEY=XXXXXXXXXXXXXXXX
TOGETHER_API_KEY=XXXXXXXXXXXXXXXX
OPEN_ROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXX

# === Video Generation ===
# Kling AI
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# Luma AI (DZ) - Secondary key
LUMA_API_KEY_DZ=luma-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Luma AI (Algeria) - Principal
LUMA_API_KEY=luma-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Runway ML
RUNWAY_API_KEY=key_XXXXXXXXXXXXXXXX

# MiniMax (JWT Token)
MINIMAX_API_KEY=your_minimax_jwt_token

# Pika Labs
PIKA_API_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX:XXXXXXXXXXXXXXXX

# Replicate
REPLICATE_API_TOKEN=r8_XXXXXXXXXXXXXXXX

# Stability AI
STABILITY_API_KEY=sk-XXXXXXXXXXXXXXXX
STABILITY_API_KEY_ALT=sk-XXXXXXXXXXXXXXXX

# === Image Generation ===
# Qwen (Alibaba Cloud)
QWEN_ACCESS_KEY_ID=LTAI5XXXXXXXXXXXXXXXX
QWEN_ACCESS_KEY_SECRET=XXXXXXXXXXXXXXXX
QWEN_API_KEY=sk-XXXXXXXXXXXXXXXX

# === Translation & Language ===
GOOGLE_TRANSLATE_API_KEY=AIzaSyXXXXXXXXXXXXXX

# === Voice & Audio ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# === Database (Docker defaults) ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/iafactory_video
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iafactory_video

# === Redis (Docker defaults) ===
REDIS_URL=redis://redis:6379

# === Auth & Security ===
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_32
NEXTAUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32
NEXTAUTH_URL=https://video-studio.iafactoryalgeria.com

# === Cloudflare R2 Storage ===
S3_BUCKET=iafactory-videos
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto

# === Stripe Payment ===
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# === Application URLs ===
FRONTEND_URL=https://video-studio.iafactoryalgeria.com
NEXT_PUBLIC_API_URL=https://api.iafactoryalgeria.com

# === Application Config ===
APP_NAME=IAFactory Video Studio Pro
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# === CORS Origins ===
CORS_ORIGINS=["https://video-studio.iafactoryalgeria.com","https://www.iafactoryalgeria.com","https://iafactoryalgeria.com"]

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === IAF-Tokens Pricing (centimes) ===
TOKEN_COST_VIDEO_GENERATION=100
TOKEN_COST_AUDIO_GENERATION=20
TOKEN_COST_SCRIPT_GENERATION=10

# === Monitoring ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# === Logs ===
LOG_LEVEL=INFO

# === Provider Defaults ===
DEFAULT_VIDEO_PROVIDER=luma
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_IMAGE_PROVIDER=stability
