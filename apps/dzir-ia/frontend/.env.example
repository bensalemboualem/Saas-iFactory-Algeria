# Dzir IA Frontend Environment Variables

# API Configuration
# ------------------
# For development: point to backend directly
# VITE_API_URL=http://localhost:4000/api

# For production: use relative path (reverse proxy handles routing)
# VITE_API_URL=/api

# API Origin (for health checks and non-/api endpoints)
# Development: http://localhost:4000
# Production: leave empty to use same origin
# VITE_API_ORIGIN=http://localhost:4000
