generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id         String    @id
  key        String    @unique
  name       String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Conversation {
  id        String    @id
  title     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  usageLedger UsageLedger[]

  @@index([createdAt])
  @@index([userId])
  @@map("conversations")
}

model CreditReservation {
  id        String   @id
  userId    String
  requestId String   @unique
  amount    Float
  status    String   @default("RESERVED")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([expiresAt])
  @@index([userId, status])
  @@map("credit_reservations")
}

model CreditTransaction {
  id             String   @id
  amount         Float
  type           String
  reason         String?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  userId         String
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([createdAt])
  @@index([orgId])
  @@index([userId])
  @@map("credit_transactions")
}

model CreditWallet {
  id        String   @id @default(uuid())
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

model Message {
  id             String       @id
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model Org {
  id                 String              @id
  name               String
  slug               String?             @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  plan               String              @default("free")
  creditTransactions CreditTransaction[]
  usageLedger        UsageLedger[]
  users              User[]

  @@map("orgs")
}

model UsageLedger {
  id             String        @id
  model          String
  provider       String
  tokens         Int
  cost           Float
  metadata       Json?
  requestId      String?       @unique
  createdAt      DateTime      @default(now())
  userId         String
  orgId          String
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  org            Org           @relation(fields: [orgId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([orgId])
  @@index([userId])
  @@map("usage_ledger")
}

model User {
  id                 String              @id
  email              String              @unique
  name               String?
  role               String              @default("user")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  orgId              String
  avatar             String?
  provider           String?
  providerId         String?
  apiKeys            ApiKey[]
  conversations      Conversation[]
  creditTransactions CreditTransaction[]
  creditWallet       CreditWallet?
  usageLedger        UsageLedger[]
  org                Org                 @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("users")
}
