# Server Configuration
NODE_ENV=development
PORT=5191
HOST=0.0.0.0
API_BASE_URL=http://localhost:5191

# Database
DATABASE_URL="postgresql://iafactory:password@localhost:5432/iafactory_gateway?schema=public"

# Redis (Rate Limiting & Cache)
REDIS_URL="redis://localhost:6379"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-secret-key-change-in-production"

# Provider API Keys (Server-side only, NEVER expose to client)
GROQ_API_KEY="gsk_..."
OPENROUTER_API_KEY="sk-or-v1-..."
DEEPSEEK_API_KEY="sk-..."
OPENAI_API_KEY="sk-..."

# Provider Base URLs
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# OpenRouter Configuration
OPENROUTER_APP_NAME="IAFactory Gateway"
OPENROUTER_APP_URL="https://iafactory.dz"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Credits & Pricing (in credits per 1M tokens)
PRICING_GPT4=30.0
PRICING_GPT35=0.5
PRICING_CLAUDE=15.0
PRICING_GROQ_FAST=0.1
PRICING_DEEPSEEK=0.3

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# ========================================
# BILLING & BETA MODE
# ========================================

# Billing mode: beta | chargily | stripe
# - beta: Free credits at signup, no payments
# - chargily: Chargily payment integration (Algeria)
# - stripe: Stripe payment integration (International)
BILLING_MODE=beta

# Beta mode settings (only used when BILLING_MODE=beta)
BETA_SIGNUP_CREDITS=5.0
BETA_DAILY_LIMIT=2.0

# ========================================
# ADMIN CONFIGURATION
# ========================================

# Admin API key for machine-to-machine calls (min 32 chars)
# Generate with: openssl rand -hex 32
# or PowerShell: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
ADMIN_API_KEY=

# Allowed IPs for admin endpoints (comma-separated)
# Use 127.0.0.1,::1 and SSH tunnel for security
# Or add your VPN/office IP
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ========================================
# DOCKER PRODUCTION (docker-compose.prod.yml)
# ========================================

# PostgreSQL
POSTGRES_USER=iafactory
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=iafactory
