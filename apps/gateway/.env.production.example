# ========================================
# IAFactory Gateway - Production Environment
# ========================================
# Copy this file to .env and fill in all values
# NEVER commit .env to git!

# ========================================
# SERVER
# ========================================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ========================================
# DATABASE (Docker internal network)
# ========================================
POSTGRES_USER=iafactory
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=iafactory
# Note: DATABASE_URL is auto-constructed in docker-compose.prod.yml

# ========================================
# AUTHENTICATION
# ========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_AT_LEAST_64_CHARS

# ========================================
# BILLING MODE
# ========================================
# beta = Free credits, no payments (for Hetzner beta launch)
# chargily = Enable Chargily payments (Algeria)
# stripe = Enable Stripe payments (International)
BILLING_MODE=beta

# ========================================
# BETA SETTINGS
# ========================================
# Credits granted at signup (beta mode only)
BETA_SIGNUP_CREDITS=5.0

# Maximum credits per day per user (beta mode only)
BETA_DAILY_LIMIT=2.0

# ========================================
# ADMIN ACCESS
# ========================================
# API key for admin endpoints (min 32 chars)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_GENERATE_A_32_CHAR_KEY_HERE

# Allowed IPs for admin endpoints (comma-separated)
# Recommended: Use SSH tunnel and keep 127.0.0.1,::1
# Or add your VPN IP: 127.0.0.1,::1,YOUR.VPN.IP.HERE
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ========================================
# LLM PROVIDERS (Server-side only)
# ========================================
# At least one provider is required

# Groq (fastest, cheapest)
GROQ_API_KEY=

# OpenRouter (access to many models)
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=IAFactory Gateway
OPENROUTER_APP_URL=https://www.iafactoryalgeria.com

# DeepSeek (good for coding)
DEEPSEEK_API_KEY=

# OpenAI (GPT-4, etc.)
OPENAI_API_KEY=

# ========================================
# RATE LIMITING
# ========================================
# Global rate limit (per IP)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ========================================
# LOGGING
# ========================================
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Set to false in production for JSON logs
LOG_PRETTY=false

# ========================================
# PRICING (credits per 1M tokens)
# ========================================
PRICING_GPT4=30.0
PRICING_GPT35=0.5
PRICING_CLAUDE=15.0
PRICING_GROQ_FAST=0.1
PRICING_DEEPSEEK=0.3
