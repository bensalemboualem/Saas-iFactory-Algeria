# =============================================================================
# IAFactory RAG-DZ - Production Environment Variables
# =============================================================================
# IMPORTANT: Fill in all values before deploying to production!
# =============================================================================

# === SERVICE ===
SERVICE_NAME=archon-rag-sovereign
SERVICE_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# === SECURITY (REQUIRED) ===
API_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD

# === DATABASE ===
# Option 1: Use Supabase (recommended for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Option 2: Use self-hosted PostgreSQL
POSTGRES_USER=postgres
POSTGRES_DB=archon
POSTGRES_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres-prod:5432/archon

# === LLM PROVIDERS (Add your API keys) ===
# At least ONE provider is required

# Groq (Recommended - Fast & Affordable)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# DeepSeek (Optional - Cheap)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Google Gemini (Optional)
GOOGLE_API_KEY=your-google-api-key-here

# === EMBEDDINGS ===
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# === RERANKING ===
USE_RERANKING=true
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKING_TOP_K=10

# === VECTOR DATABASE ===
USE_PGVECTOR=true

# Qdrant (Optional - if not using PGVector)
QDRANT_HOST=
QDRANT_PORT=6333

# === CORS & SECURITY ===
ALLOWED_ORIGINS=https://iafactory.dz,https://app.iafactory.ch,https://www.iafactoryalgeria.com
ENABLE_CORS=true
ENABLE_API_KEY_AUTH=true

# === RATE LIMITING ===
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_HOUR=3000

# === MONITORING ===
ENABLE_METRICS=true

# === FRONTEND ===
VITE_API_URL=http://localhost:8181
VITE_WS_URL=ws://localhost:8181/ws
VITE_SOVEREIGNTY_REGION=DZ

# === FIREBASE (Optional - for API key reselling) ===
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# === INTEGRATIONS (Optional) ===
# Google Calendar/Email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# n8n Workflows
N8N_WEBHOOK_URL=
